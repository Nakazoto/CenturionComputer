; 1D Life in CPL.
;
TITLE 'ODL'
SYSTEM ZODL(MAIN,EXP=D,LL=80)      ; 80 col display
FILE CRT:SYSIPT,CLASS=0,SEQ        ; CRT for user interaction
FILE PRT:SYS002,CLASS=1,SEQ        ; Print device
FORMAT CELL:C80                    ; The print out format
INTEGER CNT, XPA, XPB              ; Counter, X-position A, X-position B
INTEGER TOT, TIM, RND              ; Neighbor total, Morris Day, random number
INTEGER TMP, LIN, MDN              ; Temporary holding cell, total lines
STRING PNT(1)                      ; Define the output string as 1 character
TABLE ARRA (64)                    ; A Array (64 integers)
TABLE ARRB (64)                    ; B Array (64 integers)
;
ENTRYPOINT CRT                     ; Defines symbols that are used by other libs
ENTRY                              ; Inidcates the start of actual code
OPEN IO CRT                        ; Open CRT file declared up top for I/O
; Main loop start.
TOP:
; Generate a random starting seed
CNT=0                              ; Zero out the counter
MDN=1
LOOP WHILE (CNT.LE.64)             ; First loop to generate a new life
     GTIME (INTEGER, TIM)          ; Get the current time
     RND = MOD (TIM, MDN)            ; Divide time by 3 and get remainder
     IF (RND.LE.1) DO              ; If remainder is less than 1
          ARRA(CNT) = 0            ; Set cell to dead
     END DO
     ELSE DO
          ARRA(CNT) = 1            ; Else set cell to live
     END DO
     INCR CNT
     INCR MDN
END LOOP
; Print that seed
CNT=0                              ; Zero out the counter
LOOP WHILE (CNT.LE.64)             ; Loop for printing
     TMP = ARRA(CNT)               ; Get the value from the array
     IF (TMP.EQ.0)'PNT'="' '"      ; String assignments are weird
     IF (TMP.EQ.1)'PNT'="'*'"      ; This should work
     WRITEN(CRT,CELL)PNT           ; Write that to the screen without a newline
     INCR CNT
END LOOP
WRITE(CRT,CELL)''                  ; This should print a new line
; Do the calculation
LIN = 0
LOOP WHILE (LIN.LE.25)             ; Main loop to do 25 lines of life
     CNT = 0                       ; Counter for moving through array
     LOOP WHILE (CNT.LE.64)        ; Loop for calculating next life
          TOT = 0                  ; Zero out total number of neighbors
          TMP = ARRA(CNT-2)        ; Count up total number of neighbors
          IF (TMP.EQ.1)INCR TOT
          TMP = ARRA(CNT-1)
          IF (TMP.EQ.1)INCR TOT
          TMP = ARRA(CNT+1)
          IF (TMP.EQ.1)INCR TOT
          TMP = ARRA(CNT+2)
          IF (TMP.EQ.1)INCR TOT
          TMP = ARRA(CNT)
          ARRB(CNT) = 0            ; Zero out the second array
          IF (TMP.EQ.0) DO         ; If cell is already dead
               IF (TOT.EQ.2) DO
                    ARRB(CNT) = 1
               END DO
               IF (TOT.EQ.3) DO
                    ARRB(CNT) = 1
               END DO
          END DO
          IF (TMP.EQ.1) DO         ; If cell is already alive
               IF (TOT.EQ.2) DO
                    ARRB(CNT) = 1
               END DO
               IF (TOT.EQ.4) DO
                    ARRB(CNT) = 1
               END DO
          END DO
          INCR CNT
     END LOOP
     ; Copy and print the new line
     CNT = 0                       ; Counter for moving through array
     LOOP WHILE (CNT.LE.64)        ; Loop for copying and printing
          TMP = ARRB(CNT)
          ARRA(CNT) = TMP
          IF (TMP.EQ.0)'PNT'="' '"      ; String assignments are weird
          IF (TMP.EQ.1)'PNT'="'*'"      ; This should work
          WRITEN(CRT,CELL)PNT      ; Write that to the screen without a newline
          INCR CNT
     END LOOP
     WRITE(CRT,CELL)''             ; This should print a new line
     INCR LIN
END LOOP
GO TO TOP
CLOSE CRT                          ; Closes that CRT file
STOP 0                             ; Return control to OS with completion code 0
END